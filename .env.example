# AgentArena — environment template. Copy to .env (gitignored) and fill in.
# The key is read ONLY by the agent process (agent/agent.py); it is never sent to
# or logged by the server or the Web UI. Needed only to run a LIVE agent — the
# server, the UI, and the test suite make no paid calls and need no key.
ANTHROPIC_API_KEY=
