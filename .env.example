# AgentArena — environment template. Copy to .env (gitignored) and fill in.
# The key is read ONLY by the agent process (agent/agent.py); it is never sent to
# or logged by the server or the Web UI. Needed to run a LIVE agent. The default
# test suite mocks the model and needs no key, but live calls are permitted —
# see CLAUDE.md.
ANTHROPIC_API_KEY=
